{
  "manifest_version": 3,
  "name": "TailorResume Assistant",
  "version": "0.9.3",
  "description": "Bid from a docked side panel: pick a profile and a job, build the CV, autofill the application form (CV attached), then mark applied, report or skip.",
  "minimum_chrome_version": "116",
  "update_url": "https://tailorresume.duckdns.org/api/extension/update.xml",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "sidePanel",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://tailorresume.duckdns.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TailorResume Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Autofill the application form on this tab"
    }
  },
  "key": ""
}
